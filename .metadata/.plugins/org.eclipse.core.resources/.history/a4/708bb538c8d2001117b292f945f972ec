package comm.app.core;

import java.util.Scanner;

public class ArrayExercise {

	public static void main(String[] args) {
		// TODO Auto-generated method stub

		Scanner sc = new Scanner(System.in);
		// simple array printing

		int[] number = { 10, 20, 30, 40, 50 };
		
		System.out.println("Displaying number array");
		for (int i = 0; i < number.length; i++) {
			System.out.print(" " + number[i]);
		}
		System.out.println("");
		
		
		// taking I/P from user
		System.out.println("Enter size of array1");
		int[] array1 = new int[sc.nextInt()];
		
		System.out.println("Enter "+array1.length+" for array");
		for (int i = 0; i < array1.length; i++) {
			array1[i] = sc.nextInt();
		}

		System.out.println("Displaying array1 element");
		
		for (int i = 0; i < array1.length; i++) {
			System.out.print(" " + array1[i]);
		}
		 System.out.println();
		// sum and average  of array element
		int sum=0;
	    double average;
		for(int a=0;a<array1.length;a++) {
			sum=sum+array1[a];
		}
		average=sum/array1.length;
		System.out.println("Sum of array element is "+sum);
		System.out.println("Average of array element is "+average);
		
		//finding largest and smallest number in array
		System.out.println("");
		int largest=array1[0];
		int smallest=array1[0];
		for(int m=1;m<array1.length;m++) {
			if(array1[m]>largest) {
				largest=array1[m];
			}
			if(array1[m]<smallest) {
				smallest=array1[m];
			}
		 }
		System.out.println("The largest number in array1 is "+largest);
		System.out.println("The Smallest number in array1 is "+smallest);
		
		//Reverse the array       
		System.out.println("Reverse of array1");
		 for(int k=array1.length-1;k>=0;k--) {
			 System.out.print(" "+array1[k]);
		 }
		 
		 //search element in array
		 int index=-1;
		 System.out.println();
		 System.out.println("Enter number to search");
		 int target=sc.nextInt();
		for(int i=0;i<array1.length;i++) {
			if(array1[i]==target) {
				index=i;
			 break;
			}
		}
		if(index !=-1)
		System.out.println("Target found at "+index);
		else
		{System.out.println("Not found");
			
		}
		
		//counting even and odd nuber
		
	}

}
